root = true

[*]
indent_style = tab
indent_size = 2
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space

[*.md]
indent_style = space
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# Private fields: camelCase, no leading underscore. IDE1006 at warning so the build enforces it.
dotnet_naming_rule.private_fields_camel.symbols = private_fields
dotnet_naming_rule.private_fields_camel.style = camel_no_prefix
dotnet_naming_rule.private_fields_camel.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected
dotnet_naming_style.camel_no_prefix.capitalization = camel_case
dotnet_diagnostic.IDE1006.severity = warning

# Test names are sentences with underscores.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

[**/Internal/Generated/**.cs]
generated_code = true
