<Project>
	<PropertyGroup>
		<!-- Every package version is pinned here, exactly; project files carry no versions. -->
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="Alba" Version="8.5.3" />
		<PackageVersion Include="Fisher" Version="1.21.1" />
		<PackageVersion Include="JasperFx.Events" Version="2.90.1" />
		<PackageVersion Include="NodaTime" Version="3.3.5" />
		<PackageVersion Include="Shouldly" Version="4.3.0" />
		<PackageVersion Include="Spectre.Console" Version="0.57.2" />
		<PackageVersion Include="System.CommandLine" Version="2.0.13" />
		<PackageVersion Include="WolverineFx.Fisher" Version="6.51.0" />
		<PackageVersion Include="WolverineFx.Http" Version="6.51.0" />
		<!-- The MTP v2 variant matches the SDK's Microsoft.Testing.Platform runner. -->
		<PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
	</ItemGroup>
</Project>
