<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>gig</AssemblyName>
		<IsAotCompatible>true</IsAotCompatible>
		<!-- #3: include the linux AOT packs in locked restores before CI publishes. -->
		<RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
		<PublishAot>true</PublishAot>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../Gigtime.Contracts/Gigtime.Contracts.csproj" />
		<ProjectReference Include="../Gigtime.Platform/Gigtime.Platform.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Spectre.Console" />
		<PackageReference Include="System.CommandLine" />
	</ItemGroup>
	<ItemGroup>
		<!-- #26: a RID-less restore never downloads the NativeAOT runtime pack; a RID restore adds it itself. -->
		<PackageDownload Include="Microsoft.NETCore.App.Runtime.NativeAOT.linux-x64" Version="[$(BundledNETCoreAppPackageVersion)]" Condition="'$(RuntimeIdentifier)' == ''" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="_gig" LogicalName="gig._gig" />
	</ItemGroup>
</Project>
