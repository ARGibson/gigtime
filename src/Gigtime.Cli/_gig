#compdef gig
local context state state_descr line
typeset -A opt_args
local -a commands
commands=(
  'setup:install or inspect user units' 'completion:print shell completion'
  'defaults:global defaults' 'client:manage clients' 'project:manage projects'
  'start:start a task' 'pause:pause' 'resume:resume' 'stop:stop' 'status:show open task'
  'log:recent tasks' 'show:show a task' 'add:backfill' 'amend:correct a task'
  'void:void a task' 'report:report totals' 'export:export events'
)
if (( CURRENT == 2 )); then
  if [[ $PREFIX == --* ]]; then compadd -- --help --json --version; return; fi
  _describe 'command' commands
  return
fi
case "$words[2]" in
  client|project|defaults|completion)
    if (( CURRENT == 3 )); then
      case "$words[2]" in
        client|project) compadd add set list archive ;;
        defaults) compadd show set ;;
        completion) compadd zsh ;;
      esac
      return
    fi ;;
esac
# Flags are offered through _arguments; positional keys come from the daemon.
local -a flags
flags=('--json[JSON output]' '--help[show help]')
case "$words[2] $words[3]" in
  'setup '*) flags+=('--check[inspect only]' '--gigtimed[daemon executable]:path:_files') ;;
  'defaults set') flags+=('--timezone[timezone]:zone:'
    '--week-starts[first weekday]:day:'
    '--rounding[rounding]:policy:') ;;
  'client add'|'client set')
    flags+=('--name[display name]:name:'
      '--currency[currency]:currency:'
      '--timezone[timezone]:zone:'
      '--rounding[rounding]:policy:')
    if [[ $words[3] == set ]]; then flags+=('--key[new key]:key:'
      '--clear-timezone[inherit timezone]'
      '--clear-rounding[inherit rounding]'); fi ;;
  'client list'|'project list') flags+=('--all[include archived]') ;;
  'project add'|'project set')
    flags+=('--name[display name]:name:' '--rate[hourly rate]:amount:' '--rounding[rounding]:policy:')
    if [[ $words[3] == set ]]; then flags+=('--key[new key]:key:'
      '--clear-rate[clear rate]'
      '--clear-rounding[inherit rounding]'); fi ;;
esac
case "$words[2]" in
  start) flags+=('--ref[opaque reference]:reference:') ;;
  add) flags+=('--from[start time]:time:' '--to[end time]:time:' '--ref[opaque reference]:reference:') ;;
  amend) flags+=('--interval[interval number]:number:' '--start[start time]:time:' '--end[end time]:time:'
    '--client[client key]:client:->live'
      '--project[project key]:project:->live'
      '--ref[opaque reference]:reference:'
      '--clear-ref[clear reference]') ;;
  void) flags+=('--reason[reason]:reason:') ;;
  log) flags+=('--last[count]:number:'
    '--client[client key]:client:->live'
    '--project[project key]:project:->live'
    '--all[include voided]') ;;
  report) flags+=('--week[this week]'
    '--month[this month]'
    '--range[inclusive dates]:range:'
    '--client[client key]:client:->live'
    '--project[project key]:project:->live') ;;
  export) flags+=('--from[lower bound]:time:' '--to[upper bound]:time:') ;;
esac
_arguments -s $flags '*:argument:->live'
[[ $state == live ]] || return
local kind= client=
case "$words[CURRENT-1]" in
  --client) kind=clients ;;
  --project) kind=projects
    local i
    for (( i=3; i<CURRENT; i++ )); do [[ $words[i] == --client ]] && client=$words[i+1]; done ;;
  --*) return ;;
  *)
    case "$words[2]" in
      start|add) (( CURRENT == 3 )) && kind=clients
        if (( CURRENT == 4 )); then kind=projects; client=$words[3]; fi ;;
      client) [[ $words[3] != add && $CURRENT == 4 ]] && kind=clients ;;
      project) (( CURRENT == 4 )) && kind=clients
        if [[ $words[3] != add && $CURRENT == 5 ]]; then kind=projects; client=$words[4]; fi ;;
      show|amend|void) (( CURRENT == 3 )) && kind=tasks ;;
    esac ;;
esac
[[ -n $kind ]] || return
local -a values
if [[ -n $client ]]; then values=("${(@f)$(gig __complete "$kind" "$PREFIX" --client "$client")}")
else values=("${(@f)$(gig __complete "$kind" "$PREFIX")}"); fi
(( $#values )) && compadd -- $values
