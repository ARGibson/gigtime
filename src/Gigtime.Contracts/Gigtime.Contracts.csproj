<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;RuntimeIdentifier">
	<PropertyGroup>
		<!-- #3: CLI publish globals must not change this portable library’s locked restore graph. -->
		<PublishAot>false</PublishAot>
		<RuntimeIdentifier />
		<AssemblyName>Gigtime.Contracts</AssemblyName>
		<!-- Contracts must remain usable by the Native AOT client. -->
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="NodaTime" />
	</ItemGroup>
	<ItemGroup>
		<!-- #35: one TZDB id resolver shared without coupling domain and contracts. -->
		<Compile Include="../Shared/TimeZones.cs" Link="TimeZones.cs" />
	</ItemGroup>
</Project>
