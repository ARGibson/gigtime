<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;RuntimeIdentifier">
	<PropertyGroup>
		<!-- #3: CLI publish globals must not change this portable library’s locked restore graph. -->
		<PublishAot>false</PublishAot>
		<RuntimeIdentifier />
		<IsAotCompatible>true</IsAotCompatible>
		<!-- #2: LibraryImport generates the AOT-safe statx/geteuid ownership check. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
</Project>
